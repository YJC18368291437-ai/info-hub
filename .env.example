# QQ collection -> mailbox. Do not commit credentials.
HOST=127.0.0.1
PORT=8082
LOG_LEVEL=INFO
# Main account; .env alone does not log into NapCat.
SELF_QQ=123456789
MAIN_QQ=123456789
DRY_RUN=true
LIVE_DELIVERY_ENABLED=false
MAIL_ENABLED=false
# Separate inbox account; never infer it from SELF_QQ.
MAIL_ADDRESS=collector-inbox@example.invalid
MAIL_AUTH_CODE=
MAIL_SEND_MODE=append
MAIL_IMAP_HOST=imap.qq.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_FROM_NAME=info-hub
MAIL_POLL_SECONDS=300
MAIL_UNINTERESTED_FOLDER=不感兴趣
MAIL_DAILY_LIMIT=0
# Offline/crash alert recipient. Empty = send to MAIL_ADDRESS.
ALERT_EMAIL_TO=
# Empty = all collected groups/topics. Set to restrict mail delivery.
MAIL_SOURCE_GROUPS=
MAIL_TOPICS=
MAIL_WEEKLY_ENABLED=true
# Newspaper digest: notification paper + tech report.
NEWSPAPER_ENABLED=false
# Keep false until the sample email layout is confirmed.
NEWSPAPER_OFFICIAL_SEND=false
# false = newspaper replaces legacy immediate/daily mail; true = rollback.
NEWSPAPER_LEGACY_EVENTS=true
TIMEZONE=Asia/Shanghai
SUMMARY_HOURS=8,12,18
MAIL_WEEKLY_DOW=sun
MAIL_WEEKLY_HOUR=20
BLOCK_WINDOW_SECONDS=120
BLOCK_MERGE_WINDOW=300
BLOCK_MAX_MESSAGES=25
PIPELINE_INTERVAL_SECONDS=20
FEWSHOT_LIMIT=12
# Existing DeepSeek only; opt-in. Failure produces visible needs_review.
LLM_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ASR_ENABLED=false
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# Legacy retained, disabled by default.
TG_ENABLED=false
TG_TOKEN=
TG_CHAT_ID=0
TG_PROXY=
